{
  "about": "agent.js fmtRow and core/value_delta.py format_card_row write these rows alike; apRefusedText and agent_api._refusal_line write these lines alike (docs/254, docs/272).",
  "rows": [
    {"case": "exact half in V rounds up like toFixed", "values": [0.03125, 0.02, 0.04], "display": {"unit": "V", "scale": 1.0, "dp": 4, "stored": "V"}, "expect": ["0.0313 V", "0.0200 V", "0.0400 V"]},
    {"case": "fractional ns gets one decimal, half rounds up", "values": [12.25, 12, 16], "display": {"unit": "ns", "scale": 1.0, "dp": 0, "stored": "ns"}, "expect": ["12.3 ns", "12.0 ns", "16.0 ns"]},
    {"case": "whole ns stays whole", "values": [48, 40, 40, 44], "display": {"unit": "ns", "scale": 1.0, "dp": 0, "stored": "ns"}, "expect": ["48 ns", "40 ns", "40 ns", "44 ns"]},
    {"case": "GHz from Hz", "values": [5100000000.0, 5000000000, 5000000000.0, 5200000000.0], "display": {"unit": "GHz", "scale": 1e-9, "dp": 4, "stored": "Hz"}, "expect": ["5.1000 GHz", "5.0000 GHz", "5.0000 GHz", "5.2000 GHz"]},
    {"case": "GHz decimals set by a fifth-decimal old", "values": [5100000000.0, 5000000000.0, 5000040000.0, 5200000000.0], "display": {"unit": "GHz", "scale": 1e-9, "dp": 4, "stored": "Hz"}, "expect": ["5.10000 GHz", "5.00000 GHz", "5.00004 GHz", "5.20000 GHz"]},
    {"case": "a list in a unit field is its JSON text", "values": [[1000000000.0, 2000000000.0], [1000000000, 2000000000]], "display": {"unit": "GHz", "scale": 1e-9, "dp": 4, "stored": "Hz"}, "expect": ["[1000000000,2000000000]", "[1000000000,2000000000]"]},
    {"case": "no display unit: five significant digits", "values": [0.123456789, 0.1, 0.2], "display": null, "expect": ["0.12346", "0.10000", "0.20000"]},
    {"case": "no display unit: a zero every value ends in is dropped", "values": [0.1, 0.11], "display": null, "expect": ["0.10", "0.11"]},
    {"case": "no display unit: integers exactly", "values": [10, 9, 9, 12], "display": null, "expect": ["10", "9", "9", "12"]},
    {"case": "dBm with one decimal", "values": [-11, -12.5, -10], "display": {"unit": "dBm", "scale": 1, "dp": 1, "stored": "dBm"}, "expect": ["-11.0 dBm", "-12.5 dBm", "-10.0 dBm"]},
    {"case": "inf as the card gets it (null) and None", "values": [null, 0.5, 0.25], "display": {"unit": "V", "scale": 1.0, "dp": 4, "stored": "V"}, "expect": ["null", "0.5000 V", "0.2500 V"]},
    {"case": "large no-unit value goes exponential", "values": [12345678.9, 0.5], "display": null, "expect": ["1.2346e+7", "5.0000e-1"]},
    {"case": "a string and a bool", "values": ["abc", true, 3], "display": null, "expect": ["abc", "true", "3"]}
  ],
  "refusals": [
    {"case": "GHz keeps the stored bracket", "path": "qubits.q1.f_01",
     "row": {"now_known": true, "now": 5100000000.0, "old": 5000000000.0, "display": {"unit": "GHz", "scale": 1e-9, "dp": 4, "stored": "Hz"}},
     "sent": {"seen_now": 5000000000, "new": 5200000000.0},
     "expect": "qubits.q1.f_01 changed to 5.1000 GHz since the card showed 5.0000 GHz; press again (stored in Hz: now 5100000000, the card's 5000000000)"},
    {"case": "ns has no bracket", "path": "qubits.q1.xy.operations.x180.length",
     "row": {"now_known": true, "now": 48, "old": 40, "display": {"unit": "ns", "scale": 1.0, "dp": 0, "stored": "ns"}},
     "sent": {"seen_now": 40, "new": 44},
     "expect": "qubits.q1.xy.operations.x180.length changed to 48 ns since the card showed 40 ns; press again"},
    {"case": "exact half in V", "path": "qubits.q1.z.joint_offset",
     "row": {"now_known": true, "now": 0.03125, "old": 0.02, "display": {"unit": "V", "scale": 1.0, "dp": 4, "stored": "V"}},
     "sent": {"seen_now": 0.02, "new": 0.04},
     "expect": "qubits.q1.z.joint_offset changed to 0.0313 V since the card showed 0.0200 V; press again"},
    {"case": "fifth GHz decimal from old", "path": "qubits.q1.f_01",
     "row": {"now_known": true, "now": 5100000000.0, "old": 5000040000.0, "display": {"unit": "GHz", "scale": 1e-9, "dp": 4, "stored": "Hz"}},
     "sent": {"seen_now": 5000000000.0, "new": 5200000000.0},
     "expect": "qubits.q1.f_01 changed to 5.10000 GHz since the card showed 5.00000 GHz; press again (stored in Hz: now 5100000000, the card's 5000000000)"},
    {"case": "no unit, a list", "path": "qubits.q1.extras.taps",
     "row": {"now_known": true, "now": [1.0, 2.5], "old": [1.0, 2.0]},
     "sent": {"seen_now": [1.0, 2.0], "new": [1.0, 3.0]},
     "expect": "qubits.q1.extras.taps changed to [1,2.5] since the card showed [1,2]; press again"},
    {"case": "not set on both sides", "path": "qubits.q1.extras.later",
     "row": {"now_known": false, "old": 1},
     "sent": {"seen_unknown": true, "new": 2},
     "expect": "qubits.q1.extras.later changed to not set since the card showed not set; press again"},
    {"case": "a string value", "path": "qubits.q1.extras.note",
     "row": {"now_known": true, "now": "b", "old": "a"},
     "sent": {"seen_now": "a", "new": "c"},
     "expect": "qubits.q1.extras.note changed to \"b\" since the card showed \"a\"; press again"}
  ]
}
